# Copy to .env and fill in. .env is gitignored.
#
# Nothing here is required to get started: the Chess.com Published-Data API and
# the Lichess public API are both free and unauthenticated for reading games.
#
# Optional. A Lichess personal access token raises your rate limit and lets you
# read your own private/correspondence games. Create one (no scopes needed for
# public reads) at: https://lichess.org/account/oauth/token
LICHESS_TOKEN=

# Optional. Overrides the engine path from config.toml.
CHESS_COACH_ENGINE_PATH=
